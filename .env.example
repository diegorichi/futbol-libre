M3U_FILE="./data/eventos.m3u"
XML_FILE="./data/eventos.xml"
AGENDA_FILE="./data/agenda_web.json"
FUTURE_AGENDA_FILE="./data/agenda_future.json"
FUTURE_AGENDA_URL="https://www.clarin.com/deportes/agenda-deportiva"
FUTURE_AGENDA_TYC_URL="https://www.tycsports.com/agenda-deportiva-hoy.html"

# Log compartido por cron y la interfaz web.
LOG_LOCATION="./logs"

FUTBOL_LIBRE_URL_FILE="./config/futbol_libre_urls.env"
# Un único sitio adicional, mantenido fuera de la lista automática de SearXNG.
FUTBOL_LIBRE_EXTRA_URL=""

# SearXNG
SEARXNG_SEARCH_URL="http://localhost:8081/search"
SEARXNG_ENGINE="duckduckgo"
SEARXNG_QUERY="futbol libre"

PARALLEL_STREAM_EXTRACTION=0
STREAM_EXTRACTION_WORKERS=1

KEYS=
#arsenal,boca,river,juventus,barcelona,madrid,bayern,san antonio

NTFY_URL="https://ntfy.sh/your-topic"
TV_EVENTS_FILE="./data/eventos.json"
PROGRESS_FILE="./data/.update-futbollibre.progress.json"

# Streaming alternativo por proxy local con salida WireGuard.
# Solo se verifica y publica si está habilitado.
STREAM_VPN_ENABLED=0
STREAM_VPN_INTERFACE="vpn0"
STREAM_VPN_CONFIG="/etc/wireguard/vpn0.conf"
STREAM_VPN_PROXY_HOST="192.168.0.149"
STREAM_VPN_PROXY_PORT=8888
STREAM_VPN_TTL_HOURS=4
STREAM_VPN_HANDSHAKE_MAX_AGE_SECONDS=300
STREAM_VPN_HEALTH_URL="https://api.ipify.org"
STREAM_VPN_CACHE_FILE="./data/.vpn-stream-cache.json"

HEADLESS=1
